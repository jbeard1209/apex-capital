#!/bin/bash
# =============================================================================
# Apex Capital — pre-push gate (FAST subset).
#
# Blocks a push if the wiring audit or the WIRING-CONTRACT tests fail. Catches
# the silent producer/consumer bug class (a producer emits a rule/pod/category
# name no consumer handles, .get()/try-except swallows it, output is produced
# but never acted on) before it reaches prod, where the VM runs it 6x a day.
#
# 2026-09-04 SPLIT: the FULL smoke suite (1559 tests, ~2h 14min per zone) used
# to run here. That is longer than github's SSH idle timeout, which meant every
# push under the "old" gate exited 141 (SIGPIPE — connection died while the
# gate was still running). The gate would say "OK" and the push would still
# fail. Under `--no-verify` the fix could not even land through its own gate.
# See [[gate-outlived-its-connection]].
#
# The fast gate here runs the tests that DIRECTLY guard "block-push" contracts:
#   * wiring_audit.py — statically enforces producer/consumer name matches.
#   * TestWiringContracts (56 tests) — the specific bug class this hook exists
#     to catch. Ran under both the local zone and TZ=UTC (VM zone) to keep the
#     host-divergence guard from memory [[host_divergence_is_a_bug_class]].
#
# The rest of the suite (~1500 tests) runs OFF the push path via
# `institutional-tracker/slow_gate.py`, scheduled by the host that runs main.py
# (VM cron / Mac launchd) and reporting to `data/slow_gate_report.json`. The
# Chairman decision queue tracks its status; a red slow-gate escalates the same
# way any other production failure does.
#
# Install (.git/hooks is not cloned, so every checkout must do this once):
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# CLAUDE.md has told every session to run exactly that command since the gate
# was introduced — but the hardened version of this file lived only in
# .git/hooks on one Mac, while the copy in git stayed the original stub. So the
# install command above, followed faithfully, DOWNGRADED the gate to a
# fail-open one. Fourth instance of this shape, found 2026-08-02, after
# build_365d_labels.py (referenced by nine modules, never ran),
# scripts/refresh_crontab_snapshot.sh (named by wiring_audit.py and by a test
# that hard-fails without it, never written), and this hook's own first miss.
# A documented artifact is not a built one — and a built one that is not the
# tracked one is worse, because everybody reads the tracked one.
#
# To bypass deliberately: git push --no-verify
# =============================================================================

ROOT="$(git rev-parse --show-toplevel)"
TRACKER="$ROOT/institutional-tracker"
TRACKED_HOOK="$ROOT/scripts/git-hooks/pre-push"

# Absolutise $0 BEFORE the cd below. git invokes the hook as a path relative to
# the repo root (".git/hooks/pre-push"), so after `cd "$TRACKER"` that path
# resolves to nothing — and `cmp` against a missing file returns non-zero, which
# the self-check would report as "your hook has drifted". It blocked the very
# push that introduced it, on two byte-identical files. Fail-closed behaved
# correctly; the message was a lie. Resolve the path while it still means
# something.
HOOK_PATH="$0"
case "$HOOK_PATH" in
    /*) ;;
     *) HOOK_PATH="$PWD/$HOOK_PATH" ;;
esac

# Fail CLOSED. The original hook ended this line with `|| exit 0`, so anything
# that made the cd fail — wrong layout, a worktree without the subdir — silently
# allowed every push with a cheerful nothing. A gate that disables itself when
# confused is the same failure this gate exists to catch. If the tree really is
# unusual, --no-verify is the explicit escape hatch.
cd "$TRACKER" || {
    echo "[pre-push] BLOCKED: cannot cd to $TRACKER — the gate could not run."
    echo "[pre-push] If this tree is intentionally laid out differently: git push --no-verify"
    exit 1
}

# The gate checks that it IS the gate the repo ships. This file is not under
# version control at its installed path, so it can drift from the tracked copy
# indefinitely with nobody able to see it — which is exactly what happened.
# Runs only where the hook is installed, so it cannot false-alarm on a clone.
if [ -f "$TRACKED_HOOK" ]; then
    if [ ! -r "$HOOK_PATH" ]; then
        # Say what actually went wrong. "Cannot compare" is not "differs", and
        # reporting it as drift sends the reader to re-install a hook that was
        # never wrong — the same sin as an empty section rendering as all-clear.
        echo "[pre-push] BLOCKED: cannot locate the running hook ($HOOK_PATH),"
        echo "[pre-push] so the gate cannot confirm it matches the tracked copy."
        echo "[pre-push] Deliberate bypass: git push --no-verify"
        exit 1
    fi
    if ! cmp -s "$HOOK_PATH" "$TRACKED_HOOK"; then
        echo "[pre-push] BLOCKED: the installed hook differs from scripts/git-hooks/pre-push."
        echo "[pre-push] Your gate is not the repo's gate. Re-install it:"
        echo "[pre-push]   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push"
        exit 1
    fi
fi

echo "[pre-push] fast gate: wiring audit + TestWiringContracts (local + TZ=UTC)..."

python3 wiring_audit.py --quiet || {
    echo "[pre-push] BLOCKED: wiring contract violation. Run: python3 wiring_audit.py"
    exit 1
}

# Report the failures, not the last 15 lines.
#
# This used to be `tail -15 "$SMOKE_OUT"`, which was STRUCTURALLY guaranteed to
# print the wrong 15 lines. unittest writes its progress and its tracebacks to
# stderr as the run proceeds; the tests' own print() goes to stdout, which is
# block-buffered when redirected to a file and therefore flushed LAST, at
# process exit. So the end of the file is always the chattiest stdout the suite
# produced, and the failure that blocked the push has scrolled off the top.
#
# On 2026-08-27 this gate correctly blocked a push and printed fifteen lines of
# "hygiene: 1 verified-closed" and "CANNOT REVIEW: /var/folders/.../gone.json".
# Neither names a test. The only way forward was to re-run the 8-minute suite
# blind — and it then passed twice, so the evidence of what actually failed was
# gone for good. A gate that blocks without saying why costs more than a gate
# that does not block: you cannot fix what it will not name.
#
# The log is also KEPT on the failure path. It was deleted on exactly the path
# where somebody needs it.
_report_smoke_failure() {
    local f="$1"
    if grep -qE '^(FAIL|ERROR):' "$f"; then
        grep -E '^(FAIL|ERROR):' "$f"
    else
        echo "  (no FAIL:/ERROR: header — the run died before unittest reported;"
        echo "   see the tail below and the full log)"
    fi
    grep -E '^(Ran [0-9]+ test|FAILED|OK )' "$f" | tail -2
    echo "  ── last 25 lines ──────────────────────────────────────────────"
    tail -25 "$f"
    echo "  ── full log: $f (kept deliberately) ───────────────────────────"
}

# Fast gate: TestWiringContracts only. This is the specific class that pins the
# producer/consumer name-match contracts the hook exists to protect. Every
# other test class in test_pipeline_smoke.py runs off the push path via
# slow_gate.py.
SMOKE_OUT="$(mktemp)"
PYTHONUNBUFFERED=1 python3 -m unittest -v test_pipeline_smoke.TestWiringContracts \
    > "$SMOKE_OUT" 2>&1 || {
    echo "[pre-push] BLOCKED: wiring-contract tests failed:"
    _report_smoke_failure "$SMOKE_OUT"
    exit 1
}

# Second pass in the PRODUCTION zone. The VM runs UTC and trades continuously;
# this Mac runs America/New_York. A test that fabricated an Eastern wall clock
# passed here at every hour and failed on the VM for four hours a night
# (00:00-04:00 ET) — found 2026-08-02, green locally the whole time.
# "Green on the Mac is not green" (memory host_divergence_is_a_bug_class);
# the gate should measure the host that actually runs the money.
TZ=UTC PYTHONUNBUFFERED=1 python3 -m unittest -v test_pipeline_smoke.TestWiringContracts \
    > "$SMOKE_OUT" 2>&1 || {
    echo "[pre-push] BLOCKED: wiring-contract tests pass locally but FAIL under TZ=UTC,"
    echo "[pre-push] which is the zone the GCP VM runs in. This would ship red."
    _report_smoke_failure "$SMOKE_OUT"
    exit 1
}
rm -f "$SMOKE_OUT"

echo "[pre-push] OK (fast gate, local + TZ=UTC)."
echo "[pre-push] Slow gate (full suite, ~4.5h) runs off-path via slow_gate.py — see data/slow_gate_report.json."
