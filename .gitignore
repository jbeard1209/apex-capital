# =============================================================================
# APEX CAPITAL — Root .gitignore
# =============================================================================

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
*.env
config_local.py
institutional-tracker/.env
CREDENTIALS.md

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
institutional-tracker/logs/
*.log

# ── Backups ───────────────────────────────────────────────────────────────────
institutional-tracker/data/backups/

# ── Transient lock / run markers (must never be committed) ───────────────────
*.lock
institutional-tracker/data/.*.lock
institutional-tracker/data/.*_running
institutional-tracker/data/.catch_up_running

# ── Runtime data (live trade state, PII, agent evaluations) ──────────────────
# These are pushed directly to the cloud server via sync_to_cloud.py,
# never stored in git.
institutional-tracker/data/state.json
institutional-tracker/data/manager_decisions.json
institutional-tracker/data/board_meeting_report.json
institutional-tracker/data/canary_alert.json
institutional-tracker/data/canary_state.json
institutional-tracker/data/capital_efficiency_report.json
institutional-tracker/data/chief_of_staff_report.json
institutional-tracker/data/cos_advice_history.json
institutional-tracker/data/hr_history.json
institutional-tracker/data/ratchet_integrity_history.json
institutional-tracker/data/hr_report.json
institutional-tracker/data/hr_irm_sealed.json
institutional-tracker/data/irm_daily_check.json
institutional-tracker/data/rd_geopolitical_context.json
institutional-tracker/data/rd_historical_context.json
institutional-tracker/data/rd_system_performance.json
institutional-tracker/data/research_team_report.json
institutional-tracker/data/review_recommendations.json
institutional-tracker/data/risk_bulletin.json
institutional-tracker/data/risk_manager_report.json
institutional-tracker/data/thematic_positions.json
institutional-tracker/data/trade_review_report.json
institutional-tracker/data/cit_morning_report.json
institutional-tracker/data/cit_evening_report.json
institutional-tracker/data/cit_pending_proposals.json
institutional-tracker/data/cit_backlog.json
institutional-tracker/data/cit_sensitive.json
institutional-tracker/data/cit_approved_proposals.json
institutional-tracker/data/cit_history.json
institutional-tracker/data/energy_research_report.json
institutional-tracker/data/cos_hr_coordination.json
institutional-tracker/data/rd_ml_history.json
institutional-tracker/data/performance_ledger.json

# ── Oracle / GCP credentials ─────────────────────────────────────────────────
institutional-tracker/oracle_setup/oci_key.pem
institutional-tracker/oracle_setup/oracle_attempts.log
institutional-tracker/oracle_setup/try_oracle.py
institutional-tracker/oracle_setup/deploy.py
institutional-tracker/oracle_setup/setup_server.sh

# ── Generated reports (can be regenerated) ───────────────────────────────────
institutional-tracker/reports/
reports/

# ── Dashboard local files (pushed directly to Railway, not through git) ──────
dashboard/sync.log
dashboard/history.json

# ── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
institutional-tracker/data/historical_13f.db
institutional-tracker/data/historical_13f.db-journal
institutional-tracker/data/filing_tickers.json
config/llm_config.json
*.env
institutional-tracker/data/historical_13f.db-wal
institutional-tracker/data/historical_13f.db-shm
institutional-tracker/data/historical_13f.db-journal

# Claude scratch/diagnostic scripts (never commit)
institutional-tracker/_*.py
institutional-tracker/deploy_stamp.json
