# =============================================================================
# APEX CAPITAL — Root .gitignore
# =============================================================================

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
*.env
config_local.py
institutional-tracker/.env
CREDENTIALS.md

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
institutional-tracker/logs/
*.log

# ── Arm files — authorisation to transmit real orders ────────────────────────
# These are the files that turn shadow mode into live order submission:
#   data/.kalshi_armed  -> kalshi_client.place_order()
#   data/.fi_armed      -> fi_executor's transmit branch
#
# Neither was ignored until 2026-08-19, which was a live hazard rather than an
# untidiness. deploy.sh now derives its exclusions from `git ls-files --others`,
# so tracked files ship to the trading VM automatically — meaning one careless
# `git add data/` on the Mac would have committed an arm file and the next
# deploy would have armed the always-on host that actually runs the pipeline.
# The Chairman would have authorised one machine and armed a different one.
#
# Ignored, they can never travel. Arming is per-host by construction, which is
# right: there is no state sync between the Mac and the VM, and fi_pipeline runs
# on the VM. Arm where the pipeline runs, deliberately, by hand.
institutional-tracker/data/.fi_armed
institutional-tracker/data/.kalshi_armed

# ── Backups ───────────────────────────────────────────────────────────────────
institutional-tracker/data/backups/

# ── Transient lock / run markers (must never be committed) ───────────────────
*.lock
institutional-tracker/data/.*.lock
institutional-tracker/data/.*_running
institutional-tracker/data/.catch_up_running

# This host's stable identity (order_ledger._host_tag). Per-host BY DEFINITION —
# committing or rsyncing it would give every host the same tag, every order the
# same stamp, and the single-writer detector would then see one writer forever.
# The check exists to count hosts; sharing this file makes the count always 1.
institutional-tracker/data/.host_id

# Rendered snapshot of the re-entry slate. The page is generated live on every
# request (dashboard_server /reentry); the file is only a convenience copy for
# when the server is not running. Committing it would put a dated snapshot in
# the repo that reads as current — the exact thing the page was built to avoid.
institutional-tracker/data/reentry_slate.html

# ── Runtime data (live trade state, PII, agent evaluations) ──────────────────
# NOT synced anywhere. This comment used to say these files were "pushed
# directly to the cloud server via sync_to_cloud.py" — that script POSTed to
# Railway, which was decommissioned 2026-07-10, and it is on neither host's
# scheduler. Each host's runtime data has been fully independent since then
# (CLAUDE.md, "There is NO state sync between hosts"). They are excluded from
# git because they are live state and PII, and for no other reason.
institutional-tracker/data/state.json
# The lifecycle sentinel's and the board ledger's state. These were untracked
# only because nobody had run `git add -A` in this directory yet — the sentinel's
# own docstring asserted they were "gitignored + cloud-synced" while they were
# in fact neither, which is one stray `git add` away from committing live agent
# evaluations. Named explicitly now.
institutional-tracker/data/problem_lifecycle.json
institutional-tracker/data/problem_loops.json
institutional-tracker/data/board_issue_ledger.json
institutional-tracker/data/manager_decisions.json
institutional-tracker/data/board_meeting_report.json
institutional-tracker/data/canary_alert.json
institutional-tracker/data/canary_state.json
institutional-tracker/data/capital_efficiency_report.json
institutional-tracker/data/chief_of_staff_report.json
institutional-tracker/data/cos_advice_history.json
institutional-tracker/data/hr_history.json
institutional-tracker/data/ratchet_integrity_history.json
institutional-tracker/data/hr_report.json
institutional-tracker/data/hr_irm_sealed.json
institutional-tracker/data/irm_daily_check.json
institutional-tracker/data/rd_geopolitical_context.json
institutional-tracker/data/rd_historical_context.json
institutional-tracker/data/rd_system_performance.json
institutional-tracker/data/research_team_report.json
institutional-tracker/data/review_recommendations.json
institutional-tracker/data/risk_bulletin.json
institutional-tracker/data/risk_manager_report.json
institutional-tracker/data/thematic_positions.json
institutional-tracker/data/trade_review_report.json
institutional-tracker/data/cit_morning_report.json
institutional-tracker/data/cit_evening_report.json
institutional-tracker/data/cit_pending_proposals.json
institutional-tracker/data/cit_backlog.json
institutional-tracker/data/cit_sensitive.json
institutional-tracker/data/cit_approved_proposals.json
institutional-tracker/data/cit_history.json
institutional-tracker/data/energy_research_report.json
institutional-tracker/data/cos_hr_coordination.json
institutional-tracker/data/rd_ml_history.json
institutional-tracker/data/performance_ledger.json

# ── Oracle / GCP credentials ─────────────────────────────────────────────────
institutional-tracker/oracle_setup/oci_key.pem
institutional-tracker/oracle_setup/oracle_attempts.log
institutional-tracker/oracle_setup/try_oracle.py
institutional-tracker/oracle_setup/deploy.py
institutional-tracker/oracle_setup/setup_server.sh

# ── Generated reports (can be regenerated) ───────────────────────────────────
