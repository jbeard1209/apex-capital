# =============================================================================
# APEX CAPITAL — .gitignore
# =============================================================================

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
config_local.py

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Data & logs (large, ephemeral, contain trade PII) ────────────────────────
logs/
data/backups/

# Runtime data files — contain live trade state, decisions, and agent evaluations.
# Excluded to prevent sensitive portfolio data from being pushed to GitHub.
# The two config files below (agent_registry, sector_assignments) ARE committed.
data/state.json
data/manager_decisions.json
data/board_meeting_report.json
data/canary_alert.json
data/canary_state.json
data/capital_efficiency_report.json
data/chief_of_staff_report.json
data/cos_advice_history.json
data/hr_history.json
# Live per-host employment state, written by the Chief-of-Staff factory on BOTH
# hosts and deliberately excluded from deploy.sh's rsync. It was tracked until
# 2026-08-01, which meant every branch carried its own snapshot of a file that
# changes under you: main held 39 agents / 9 tombstoned, this branch 37 / 7, and
# the live Mac 67 / 0. A plain `git checkout main` would therefore have deleted
# 28 agents from the roster and silently re-retired the seven agents that had
# just been reinstated — no error, no diff anyone would read.
# The git-tracked declaration of who works here is data/agent_roster_manifest.json
# (agent_roster.py's shrink-only ratchet); this file is the runtime state it
# grades. Both readers fail-open to {"agents": []}, so a fresh clone is fine.
data/agent_registry.json
# Same shape: the surveillance log accrues one dated row per host per day.
data/agent_probation_log.json
data/hr_report.json
data/hr_irm_sealed.json
data/irm_daily_check.json
data/rd_geopolitical_context.json
data/rd_historical_context.json
data/rd_system_performance.json
data/research_team_report.json
data/review_recommendations.json
data/risk_bulletin.json
data/risk_manager_report.json
data/thematic_positions.json
data/trade_review_report.json
data/cit_morning_report.json
data/cit_evening_report.json
# parameter_audit's run output: regenerated from the source tree on every run and
# stamped with a fresh ts, so tracking it would dirty the tree on every audit.
# The two artefacts that DO matter — the derivation registry and the shrink-only
# baseline — are tracked and deployed, because they are decisions, not output.
data/parameter_audit_report.json
data/cit_pending_proposals.json
data/cit_backlog.json
data/cit_sensitive.json
data/cit_approved_proposals.json
data/cit_history.json
data/energy_research_report.json
data/cos_hr_coordination.json

# Proxy Chairman — runtime state only. The RULES file and the decision CORPUS
# are tracked (they are decisions, not output). The proposal and audit logs
# are per-host and change on every run, so they stay local like state.json.
data/proxy_chairman_proposals.json
data/proxy_chairman_audit_log.json

# Oracle setup — contains private keys and credentials
oracle_setup/oci_key.pem
oracle_setup/oracle_attempts.log
oracle_setup/try_oracle.py
oracle_setup/deploy.py
oracle_setup/setup_server.sh

# ── Reports (generated HTML — can be regenerated) ────────────────────────────
reports/

# ── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
