<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Apex Capital — daily off-VM copy of the Kalshi order ledger.
       tools/kalshi_ledger_backup.py reads the VM ledger with ssh `cat` (read-only),
       saves ~/apex_backups/kalshi/kalshi_copytrade_ledger.YYYYMMDD.jsonl, and raises
       SHRANK / REWRITTEN (HIGH + email) or STALE (no good copy for 48h) to the
       Chairman queue. 07:00 local; launchd runs a missed slot on wake. -->
  <key>Label</key>
  <string>com.apexcapital.kalshiledger</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jackbeard/Claude investment strategy/tools/kalshi_ledger_backup.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jackbeard/Claude investment strategy</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jackbeard/Claude investment strategy/institutional-tracker/logs/kalshiledger_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jackbeard/Claude investment strategy/institutional-tracker/logs/kalshiledger_launchd.log</string>
</dict>
</plist>
