<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Apex Capital — Mac / GitHub / VM sync drift check (hourly)
       tools/sync_drift_check.py compares the Mac checkout, origin/main and the
       files the VM runs. Persistent drift (past each kind's grace period) goes
       to the Chairman queue + the daily digest email; a cleared drift resolves
       its entry. It fast-forwards the Mac checkout when that cannot lose
       anything (--heal) and publishes docs/NEEDS_JACK.md + a sync section to
       the private apex-reports repo (--publish).
       launchd, not a Claude scheduled task: see com.apexcapital.vmstate.plist
       for why (Claude tasks stopped silently for 9 days while "enabled"). -->

  <key>Label</key>
  <string>com.apexcapital.syncdrift</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jackbeard/Claude investment strategy/tools/sync_drift_check.py</string>
    <string>--heal</string>
    <string>--publish</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jackbeard/Claude investment strategy</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/jackbeard/Claude investment strategy/institutional-tracker/logs/syncdrift_launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jackbeard/Claude investment strategy/institutional-tracker/logs/syncdrift_launchd.log</string>

  <key>ThrottleInterval</key>
  <integer>300</integer>

</dict>
</plist>
