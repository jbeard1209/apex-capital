# =============================================================================
# Apex Capital — Environment Configuration Example
# =============================================================================
# Copy to `.env` and fill in your values. `.env` is gitignored.
#
#     cp .env.example .env
#     $EDITOR .env
#
# Nothing in this file is a real credential — every value is a placeholder.

# -----------------------------------------------------------------------------
# Local Dashboard  (dashboard_server.py, http://localhost:5050)
# -----------------------------------------------------------------------------

# Users are supplied as a JSON object: {"username": "password", ...}
# Add as many as you like. Use strong passwords.
APEX_DASHBOARD_USERS='{"you":"CHANGE_ME","guest":"viewonly_CHANGE_ME"}'

# Optional: run the dashboard on a different port (default 5050).
# APEX_DASHBOARD_PORT=5050

# Optional: disable login entirely. LOCALHOST ONLY — never expose without auth.
# APEX_DASHBOARD_PASSWORD_REQUIRED=0

# -----------------------------------------------------------------------------
# Alpaca Paper Trading  (institutional-tracker/)
# -----------------------------------------------------------------------------
# Sign up at https://app.alpaca.markets/paper/dashboard/overview
# The firm ONLY trades the paper account. Never point it at a live account.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# Email  (agent briefings, IRM notifications, board minutes)
# -----------------------------------------------------------------------------
# Uses Gmail SMTP with an app password (not your regular Gmail password).
# https://support.google.com/accounts/answer/185833
EMAIL_SENDER=you@example.com
EMAIL_RECIPIENT=you@example.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# -----------------------------------------------------------------------------
# Optional data sources
# -----------------------------------------------------------------------------
# Quiver Quant (institutional flows, insider activity)
# QUIVER_API_KEY=your_key_here

# FRED (macro time-series)
# FRED_API_KEY=your_key_here

# Anthropic (Claude API for research and reasoning agents)
# ANTHROPIC_API_KEY=your_key_here
